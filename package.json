{
  "name": "palworld-save-bridge",
  "version": "0.1.0",
  "description": "Local, offline Palworld co-op host transfer for Windows Steam saves",
  "author": "Palworld Save Bridge contributors",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "check": "node scripts/check.mjs",
    "setup": "node node_modules/electron/install.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "io.palworldsavebridge.desktop",
    "productName": "Palworld Save Bridge",
    "directories": {
      "output": "../release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Palworld-Save-Bridge-${version}-Windows.exe"
    }
  },
  "dependencies": {
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "electron": "44.4.4",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.9"
  }
}
